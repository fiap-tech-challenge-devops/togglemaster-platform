# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# O arquivo .env nunca deve ser commitado no repositório.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_pass

# ─── auth-service ────────────────────────────────────────────────────────────
# String de conexão — deve apontar para o serviço "auth-postgres" dentro da rede Docker
DATABASE_URL=postgres://auth_user:auth_pass@auth-postgres:5432/auth_db?sslmode=disable

# Porta exposta no host
PORT=8001

# Chave mestra para o endpoint /admin/keys — troque em produção!
MASTER_KEY=admin-secreto-123

# ─── flags-postgres ───────────────────────────────────────────────────────────
FLAGS_DB=flags_db
FLAGS_DB_USER=flags_user
FLAGS_DB_PASSWORD=flags_pass

# ─── flag-service ─────────────────────────────────────────────────────────────
# String de conexão — aponta para "flags-postgres" dentro da rede Docker
FLAGS_DATABASE_URL=postgres://flags_user:flags_pass@flags-postgres:5432/flags_db

# URL do auth-service para validação de chaves de API
AUTH_SERVICE_URL=http://auth-service:8001

# ─── targeting-postgres ───────────────────────────────────────────────────────
TARGETING_DB=targeting_db
TARGETING_DB_USER=targeting_user
TARGETING_DB_PASSWORD=targeting_pass

# ─── targeting-service ────────────────────────────────────────────────────────
# String de conexão — aponta para "targeting-postgres" dentro da rede Docker
TARGETING_DATABASE_URL=postgres://targeting_user:targeting_pass@targeting-postgres:5432/targeting_db

# URL do auth-service para validação de chaves de API (mesma que acima)
TARGETING_AUTH_SERVICE_URL=http://auth-service:8001

# ─── evaluation-service ───────────────────────────────────────────────────────
# Chave de API de serviço — criar via:
#   curl -X POST http://localhost:8001/admin/keys \
#     -H "Authorization: Bearer admin-secreto-123" \
#     -d '{"name":"evaluation-service-key"}'
EVALUATION_SERVICE_API_KEY=tm_key_your_key_here

# URL da fila SQS (opcional — deixe vazio para desabilitar eventos)
AWS_SQS_URL=
AWS_REGION=us-east-1
# Use aspas se a secret contiver caracteres especiais (ex.: +)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── analytics-service ────────────────────────────────────────────────────────
# Mesma fila SQS do evaluation-service (evaluation produz, analytics consome)
# AWS_SQS_URL e AWS_REGION já definidos acima — compartilhados entre os dois serviços

# Nome da tabela DynamoDB (deve existir na AWS com partition key event_id:String)
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Credenciais IAM com permissões sqs:ReceiveMessage/DeleteMessage e dynamodb:PutItem
# AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY já definidos acima
AWS_SESSION_TOKEN=   # Preencher apenas se estiver usando AWS Academy (credenciais temporárias)
